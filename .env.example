# Copia in .env (ignorato da git) e imposta valori locali.
# SOLO valori di sviluppo: nessun segreto reale.
# SQL Server richiede almeno 8 caratteri e 3 categorie tra maiuscole, minuscole, numeri e simboli.
MSSQL_SA_PASSWORD=CambiaQuestaPassword_123!
RABBITMQ_USER=smartcampus
RABBITMQ_PASSWORD=CambiaQuestaPassword_123!

# Identity: chiave di firma dei JWT (almeno 32 caratteri; usata anche dal Gateway).
JWT_SIGNING_KEY=chiave-solo-sviluppo-locale-cambiala-0123456789
# Identity: password degli utenti sintetici (student1..5, staff1..2).
SEED_DEFAULT_PASSWORD=Campus-Dev-2026!