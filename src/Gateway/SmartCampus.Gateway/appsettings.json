{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "ReverseProxy": {
    "Routes": {
      "autenticazione": { "ClusterId": "autenticazione", "Match": { "Path": "/api/autenticazione/{**catch-all}" } },
      "spazi": { "ClusterId": "spazi", "Match": { "Path": "/api/spazi/{**catch-all}" } },
      "prenotazioni": { "ClusterId": "prenotazioni", "Match": { "Path": "/api/prenotazioni/{**catch-all}" } },
      "presenze": { "ClusterId": "presenze", "Match": { "Path": "/api/presenze/{**catch-all}" } }
    },
    "Clusters": {
      "autenticazione": { "Destinations": { "d1": { "Address": "http://localhost:5101" } } },
      "spazi": { "Destinations": { "d1": { "Address": "http://localhost:5102" } } },
      "prenotazioni": { "Destinations": { "d1": { "Address": "http://localhost:5103" } } },
      "presenze": { "Destinations": { "d1": { "Address": "http://localhost:5104" } } }
    }
  }
}
