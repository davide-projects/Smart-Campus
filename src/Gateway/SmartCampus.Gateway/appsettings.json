{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "Jwt": {
    "Issuer": "SmartCampus.Identity",
    "Audience": "SmartCampus"
  },
  "ReverseProxy": {
    "Routes": {
      "identity-login": {
        "ClusterId": "identity",
        "Order": 0,
        "AuthorizationPolicy": "Anonymous",
        "Match": { "Path": "/api/identity/login", "Methods": [ "POST" ] }
      },
      "identity": {
        "ClusterId": "identity",
        "Order": 1,
        "AuthorizationPolicy": "Default",
        "Match": { "Path": "/api/identity/{**catch-all}" }
      },
      "rooms-read": {
        "ClusterId": "rooms",
        "AuthorizationPolicy": "Anonymous",
        "Match": { "Path": "/api/rooms/{**catch-all}", "Methods": [ "GET" ] }
      },
      "rooms-manage": {
        "ClusterId": "rooms",
        "AuthorizationPolicy": "Staff",
        "Match": { "Path": "/api/rooms/{**catch-all}", "Methods": [ "POST", "PUT", "PATCH", "DELETE" ] }
      },
      "bookings-future-count": {
        "ClusterId": "bookings",
        "Order": -1,
        "AuthorizationPolicy": "Staff",
        "Match": { "Path": "/api/bookings/rooms/{roomId}/future-reservations-count", "Methods": [ "GET" ] }
      },
      "bookings-list": {
        "ClusterId": "bookings",
        "Order": -1,
        "AuthorizationPolicy": "Staff",
        "Match": { "Path": "/api/bookings", "Methods": [ "GET" ] }
      },
      "bookings": {
        "ClusterId": "bookings",
        "AuthorizationPolicy": "Default",
        "Match": { "Path": "/api/bookings/{**catch-all}" }
      }
    },
    "Clusters": {
      "identity": { "Destinations": { "d1": { "Address": "http://localhost:5101" } } },
      "rooms": { "Destinations": { "d1": { "Address": "http://localhost:5102" } } },
      "bookings": { "Destinations": { "d1": { "Address": "http://localhost:5103" } } }
    }
  }
}
