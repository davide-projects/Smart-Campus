{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "ReverseProxy": {
    "Routes": {
      "identity": { "ClusterId": "identity", "Match": { "Path": "/api/identity/{**catch-all}" } },
      "catalogo": { "ClusterId": "catalogo", "Match": { "Path": "/api/catalogo/{**catch-all}" } },
      "prenotazioni": { "ClusterId": "prenotazioni", "Match": { "Path": "/api/prenotazioni/{**catch-all}" } },
      "utilizzo": { "ClusterId": "utilizzo", "Match": { "Path": "/api/utilizzo/{**catch-all}" } }
    },
    "Clusters": {
      "identity": { "Destinations": { "d1": { "Address": "http://localhost:5101" } } },
      "catalogo": { "Destinations": { "d1": { "Address": "http://localhost:5102" } } },
      "prenotazioni": { "Destinations": { "d1": { "Address": "http://localhost:5103" } } },
      "utilizzo": { "Destinations": { "d1": { "Address": "http://localhost:5104" } } }
    }
  }
}
