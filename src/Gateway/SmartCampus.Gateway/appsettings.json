{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "ReverseProxy": {
    "Routes": {
      "identity": { "ClusterId": "identity", "Match": { "Path": "/api/identity/{**catch-all}" } },
      "rooms": { "ClusterId": "rooms", "Match": { "Path": "/api/rooms/{**catch-all}" } },
      "bookings": { "ClusterId": "bookings", "Match": { "Path": "/api/bookings/{**catch-all}" } }
    },
    "Clusters": {
      "identity": { "Destinations": { "d1": { "Address": "http://localhost:5101" } } },
      "rooms": { "Destinations": { "d1": { "Address": "http://localhost:5102" } } },
      "bookings": { "Destinations": { "d1": { "Address": "http://localhost:5103" } } }
    }
  }
}
